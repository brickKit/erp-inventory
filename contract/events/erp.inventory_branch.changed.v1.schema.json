{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brickkit.dev/erp-inventory/events/erp.inventory_branch.changed.v1.schema.json",
  "title": "erp.inventory_branch.changed.v1",
  "description": "A reservation branch (protocol 04; a full-state event, overwritable). The record ID is the branch ID the coordinator generated.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "legal_entity_id",
    "reference",
    "state",
    "reason",
    "lines",
    "hold_expires_at",
    "version",
    "updated_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "legal_entity_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid",
      "description": "null on a tombstone"
    },
    "reference": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id"
          ],
          "properties": {
            "kind": {
              "type": "string"
            },
            "id": {
              "type": "string"
            },
            "revision": {
              "type": "integer"
            },
            "line_id": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "state": {
      "enum": [
        "held",
        "committed",
        "consumed",
        "released",
        "expired",
        "rejected",
        "cancelled"
      ]
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "product_id",
          "warehouse_id",
          "quantity",
          "consumed"
        ],
        "properties": {
          "product_id": {
            "type": "string",
            "format": "uuid"
          },
          "warehouse_id": {
            "type": "string",
            "format": "uuid"
          },
          "quantity": {
            "type": "string",
            "pattern": "^[0-9]+(\\.[0-9]+)?$",
            "description": "a non-negative decimal string, base unit"
          },
          "consumed": {
            "type": "string",
            "pattern": "^[0-9]+(\\.[0-9]+)?$",
            "description": "a non-negative decimal string, base unit"
          }
        }
      }
    },
    "hold_expires_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
