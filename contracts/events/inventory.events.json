{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "erp-inventory 事件清单",
  "note": "只增不改：可以加字段、加事件，不删字段、不改类型、不改 subject。消费者宽容反序列化（不认识的字段忽略）。",
  "envelope": {
    "description": "所有事件共用的信封，由 be-sdk 的 Outbox 填写与校验",
    "required": ["subject", "aggregate_id", "version", "trace_id", "causation_id", "hop_count", "occurred_at"],
    "properties": {
      "subject":      { "type": "string", "pattern": "^[a-z]+\\.[a-z-]+\\.[a-z-]+\\.v[0-9]+$" },
      "aggregate_id": { "type": "string" },
      "version":      { "type": "integer", "description": "聚合版本，单调递增；消费者只在严格大于本地当前值时更新，因此不怕乱序与重复投递" },
      "trace_id":     { "type": "string" },
      "causation_id": { "type": "string" },
      "hop_count":    { "type": "integer", "maximum": 5, "description": "事件链跳数；大于 5 直接进死信队列，防止事件互相触发成环" },
      "occurred_at":  { "type": "string", "format": "date-time" }
    }
  },
  "events": [
    {
      "subject": "erp.inventory.adjusted.v1",
      "grade": "core",
      "note": "核心事件：经 Outbox 持久化，消费者必须幂等，处理失败进死信队列。Receive/ConfirmIssue/Adjust 三个命令都发这条，aggregate_id 是 movement_id、version 恒为 1。⚠️ 只带数量不带金额——erp-finance 消费它，自己按成本方法算出凭证金额。",
      "payload": {
        "type": "object",
        "required": ["product_id", "warehouse_id", "qty_delta", "movement_id", "reason"],
        "properties": {
          "product_id":   { "type": "string" },
          "warehouse_id": { "type": "string" },
          "qty_delta":    { "type": "string", "description": "带符号，decimal-as-string" },
          "movement_id":  { "type": "string" },
          "batch_no":     { "type": "string" },
          "serial_no":    { "type": "string" },
          "reason":       { "type": "string", "enum": ["RECEIVE", "ISSUE", "ADJUST_GAIN", "ADJUST_LOSS"] }
        }
      }
    },
    {
      "subject": "erp.inventory.transferred.v1",
      "grade": "core",
      "note": "占位：调拨还没有实现，本组件目前不发这条。先在事件清单里占住 subject，避免下游以为漏查了。",
      "payload": {
        "type": "object",
        "required": [],
        "properties": {}
      }
    }
  ]
}
